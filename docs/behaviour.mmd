graph LR
    subgraph WATCH["👁️ WHAT WATCHING ACTUALLY MEANS"]
        direction LR
        V1["frame every 1.5s"]
        V2{"changed since the<br/>last one we sent?"}
        V3["✨ ask Gemini<br/>what is in frame"]
        V4["<b>appeared</b> → remember where"]
        V5["<b>left view</b> for 12s+<br/>→ “it went in the bag”"]
        V1 --> V2
        V2 -->|"no — costs nothing"| V1
        V2 -->|yes| V3 --> V4
        V3 --> V5
    end

    subgraph LEARN["↺ WHAT IT LEARNS"]
        direction LR
        L1["every leave scan<br/>is logged"]
        L2{"carried on ≥60%<br/>of the last 8 trips?"}
        L3["✅ added to your routine"]
        L4["🕗 median departure time<br/><small>so the brief lands before<br/><b>you</b> leave, not at 08:00</small>"]
        L1 --> L2 -->|yes| L3 --> L1
        L1 --> L4
    end

    subgraph NUDGE["⏱️ A REMINDER THAT CAN CANCEL ITSELF"]
        direction LR
        N1["something missing<br/>as you leave"]
        N2["queued for<br/>+2 minutes"]
        N3{"still missing<br/>when it comes due?"}
        N4["💬 sent, with where<br/>it was last seen"]
        N5["🤫 cancelled —<br/>you already have it"]
        N1 --> N2 --> N3
        N3 -->|yes| N4
        N3 -->|"seen since"| N5
    end

    subgraph DECAY["📉 HOW SURE IT IS — one camera sighting, as it ages"]
        direction LR
        D0["<b>confidence =<br/>base × method × ½^(age ÷ 6h)</b><br/><small>visual 1.0 · voice .85 · inferred .55</small>"]
        D1["<b>0h · 0.90</b><br/>“it should still be there”"]
        D2["<b>6h · 0.45</b><br/>“I'd double-check”"]
        D3["<b>24h · 0.06</b><br/>“I wouldn't rely on it”"]
        D0 --> D1 -->|"6h half-life"| D2 --> D3
    end

    subgraph FAIL["⚠️ HOW IT FAILS — honestly, never confidently"]
        direction LR
        F1["📷 no camera<br/><small>“I can't check, but you<br/>normally take…”</small>"]
        F2["🚦 over quota<br/><small>watching pauses,<br/>says so, resumes</small>"]
        F3["🔌 no database<br/><small>/health says <b>degraded</b>,<br/>not “ok”</small>"]
        F4["🗣️ no speech<br/><small>typing always works</small>"]
        %% Unlinked nodes stack into a column and make the figure enormous;
        %% invisible links keep the lane a row.
        F1 ~~~ F2 ~~~ F3 ~~~ F4
    end

    classDef watch fill:#E6F4EA,stroke:#0B8043,color:#08341c
    classDef learn fill:#E6F4EA,stroke:#0F9D58,color:#0a3d22
    classDef nudge fill:#FCE8E6,stroke:#EA4335,color:#5c1a14
    classDef dec   fill:#E8F0FE,stroke:#4285F4,color:#0d2f6b
    classDef decf  fill:#4285F4,stroke:#1a56c4,color:#fff
    classDef fail  fill:#FFF4E5,stroke:#F57C00,color:#5c3d00
    classDef q     fill:#0F9D58,stroke:#0a6c3c,color:#fff
    classDef qr    fill:#EA4335,stroke:#a52b21,color:#fff

    class V1,V3,V4,V5 watch
    class V2 q
    class L1,L3,L4 learn
    class L2 q
    class N1,N2,N4,N5 nudge
    class N3 qr
    class D1,D2,D3 dec
    class D0 decf
    class F1,F2,F3,F4 fail
