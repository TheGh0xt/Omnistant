# ---------------------------------------------------------------------------
# Omnistant — configuration
#
# Copy to `.env` and fill in. Everything except the API key has a working
# default; unset storage falls back to in-memory so the service still boots.
# ---------------------------------------------------------------------------

# --- Gemini (required for vision + conversation) ---------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to use. Run `uv run python scripts/list_models.py` to see what
# your credentials can reach.
#
# NOTE ON FREE-TIER QUOTA (measured, not guessed): gemini-3.5-flash allows
# 5 requests/minute AND only 20 requests/DAY on the free tier. A conversational
# turn costs 2-3 requests, so that is about seven turns per day — not enough to
# record a demo. Either enable billing, or use gemini-2.5-flash, which is fully
# multimodal and has a much larger free allowance.
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-2.5-flash   # <- use this if you are on the free tier
# Optional: use a different (e.g. cheaper) model for image scans.
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# --- Or use Vertex AI instead of AI Studio ---------------------------------
# Set these and leave GEMINI_API_KEY empty. Requires application-default
# credentials (`gcloud auth application-default login`).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# Leave this as "global". Vertex serves the current Gemini models from the
# global endpoint only; a region here 404s every model call while the service
# still boots and still reports itself healthy.
# GOOGLE_CLOUD_LOCATION=global

# --- Storage ---------------------------------------------------------------
# Local development (docker compose up).
#
# POSTGRES_PASSWORD is REQUIRED and has no default anywhere — docker-compose.yml
# refuses to start without it. Generate one:
#
#     openssl rand -hex 24
#
# It is defined once, here, and DATABASE_URL is interpolated from it, so the
# password lives in exactly one gitignored place.
POSTGRES_USER=omnistant
POSTGRES_DB=omnistant
POSTGRES_PASSWORD=

# Host ports are deliberately non-default so they do not collide with a
# Postgres/Redis you already have running.
POSTGRES_PORT=5433
REDIS_PORT=6380

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://localhost:${REDIS_PORT}/0

# On Cloud Run with Cloud SQL attached via unix socket:
# DATABASE_URL=postgresql://USER:PASSWORD@/omnistant?host=/cloudsql/PROJECT:REGION:INSTANCE
# On Cloud Run with Memorystore over a VPC connector:
# REDIS_URL=redis://10.0.0.3:6379/0

# --- Behaviour -------------------------------------------------------------
# Times are spoken in this zone; storage is always UTC.
TIMEZONE=Europe/London

# Single-user demo identity. Must be a UUID.
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# How long a sighting stays trustworthy. Confidence halves every this-many hours.
RECALL_STALE_AFTER_HOURS=6

# Session and camera-frame lifetimes in Redis.
SESSION_TTL_SECONDS=86400
FRAME_TTL_SECONDS=900

# Where you are when you have not said otherwise. Observations used to be logged
# at "here", which is what the camera knows and nothing you can act on; the
# agent now labels them with the last destination you announced, falling back to
# this. Set it to "" and it will say "Unknown location" rather than assume.
DEFAULT_LOCATION_LABEL=Home

# How long after you say you're leaving to send the follow-up reminder. Two
# minutes in production: the value of the reminder decays with distance.
# Set 0.5 when recording a demo, so the loop fits inside one unedited take.
LEAVE_NUDGE_DELAY_MINUTES=2

# The evening recap's Slack bullets are built from the observation log, so the
# model round trip only produces the prose narrative for the UI. Set false to
# skip it when the job has to finish inside a demo-length window.
RECAP_NARRATE=true

# --- Notifications ---------------------------------------------------------
# Where the autonomous jobs deliver their results. Without this the agent still
# runs on schedule and still works out what you're missing — but nobody ever
# sees it, which rather defeats the point of it running unprompted.
#
# Slack: https://api.slack.com/apps -> create an app -> Incoming Webhooks ->
#        "Add New Webhook to Workspace". The URL is the only credential; posting
#        needs no token and no headers. Treat it as a secret.
SLACK_WEBHOOK_URL=

# --- Serving ---------------------------------------------------------------
PORT=8080
LOG_LEVEL=INFO

# Shared secret for /api/tasks/* so Cloud Scheduler can call them and the open
# internet cannot. Generate with: openssl rand -hex 32
# Leave unset locally; ALWAYS set it in production.
TASK_TOKEN=
